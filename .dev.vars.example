# Uses the same syntax as a .env file


ENVIRONMENT=""


# ID for the celestemods.com Cloudflare zone.
CLOUDFLARE_ZONE_ID=""

# Access token for purging celestemods.com's Cloudflare CDN cache
CLOUDFLARE_CACHE_PURGE_API_TOKEN=""


# Authentication Bindings

# Comma separated list of permitted IPs
PERMITTED_IPS=""

# Base64 encoded public key for authorized requests
PUBLIC_KEY_STRING=""

# Base64 encoded private key for use in development mode
PRIVATE_KEY_STRING=""